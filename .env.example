# ============================================================================
# AI Interview Assistant — environment template
#
# WHERE TO PUT .env FILES (npm workspaces run each app in its own directory,
# and dotenv/Vite read .env from the process working directory):
#   - Backend (Fastify API + WS):  cp .env.example apps/backend/.env
#   - Web dashboard (Vite):        cp .env.example apps/web/.env     (VITE_* only)
#   - Desktop overlay (Vite):      cp .env.example apps/desktop/.env (VITE_* only)
#   - Docker infra (compose):      infrastructure/docker-compose.yml has no .env needs
# Only VITE_* variables are exposed to the browser bundles. Never put real
# secrets in any VITE_* variable or in apps/web|desktop env files.
# Generate secrets with:  openssl rand -base64 48
# ============================================================================

# --- Core backend -----------------------------------------------------------
# Zod-validated in apps/backend/src/config.ts
NODE_ENV=development            # development | test | production
PORT=3001                       # REST API (Fastify)
WS_PORT=3002                    # realtime transcript/answer websocket
CORS_ORIGIN=http://localhost:5173   # comma-separated list is supported

# --- Database (PostgreSQL 16, matches infrastructure/docker-compose.yml) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_interview
REQUIRE_DATABASE=false          # true = refuse to boot without a database
# Raw process.env reads in apps/backend/src/db/client.ts:
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
MIGRATIONS_DIR=                 # override only if you move the migrations folder

# --- Secrets -----------------------------------------------------------------
# Dev fallbacks exist for JWT signing and at-rest encryption, but set real
# values (32+ chars each). Production REFUSES to boot without all three.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
# AES-256-GCM master key for third-party API keys stored in the database.
# Rotating this invalidates previously stored provider keys.
ENCRYPTION_KEY=

# --- AI chat providers --------------------------------------------------------
# First configured provider wins when AI_DEFAULT_PROVIDER is unset/"template";
# per-user providers stored in the DB (encrypted) take precedence over env.
AI_DEFAULT_PROVIDER=template    # template | openai | anthropic | google | groq | ollama | openai-compatible
AI_REQUEST_TIMEOUT_MS=30000     # 1000 - 120000

OPENAI_API_KEY=
OPENAI_MODEL=                   # e.g. gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=                # e.g. claude-sonnet-4-5
ANTHROPIC_BASE_URL=             # optional proxy/gateway
GOOGLE_API_KEY=
GOOGLE_MODEL=                   # e.g. gemini-2.0-flash
GOOGLE_BASE_URL=
GROQ_API_KEY=                   # chat AND transcription (whisper-large-v3)
GROQ_MODEL=

# --- Local / self-hosted ------------------------------------------------------
OLLAMA_BASE_URL=                # e.g. http://localhost:11434 (presence enables ollama)
OLLAMA_MODEL=                   # e.g. llama3.1:8b

# --- OpenAI-compatible gateway (LM Studio, vLLM, OpenRouter, ...) -------------
OPENAI_COMPAT_BASE_URL=         # required when using the openai-compatible provider
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# --- Transcription -------------------------------------------------------------
DEEPGRAM_API_KEY=               # speech-to-text (server-side only)

# --- Frontends (build-time, safe to expose) -----------------------------------
VITE_BACKEND_URL=http://localhost:3001

# --- Tests (never used at runtime) ---------------------------------------------
# DB integration tests are gated:  RUN_DB_TESTS=1 TEST_DATABASE_URL=... npm test -w apps/backend
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_interview_test
RUN_DB_TESTS=0

