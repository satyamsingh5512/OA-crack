{
  "name": "@ai-assistant/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:prod": "node dist/db/migrate.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src test --no-warn-ignored"
  },
  "dependencies": {
    "@ai-assistant/shared": "*",
    "@fastify/cors": "^10.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "argon2": "^0.41.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.0.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.3",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "ws": "^8.18.0",
    "yaml": "^2.9.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.5.12",
    "tsx": "^4.16.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
